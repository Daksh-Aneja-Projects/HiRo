# Backend image: Rust extension builder + production Python runtime.

# =========================================================================
# Stage 1: Rust builder (compiles the pac_engine_rs extension)
# =========================================================================
FROM python:3.11-slim as rust-builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain (minimal profile) for building the native wheel.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --profile minimal

ENV PATH="/root/.cargo/bin:${PATH}"

RUN pip install --no-cache-dir maturin==1.0.0

# Paths are relative to the build context (project root).
COPY backend/pac_engine_rs /app/pac_engine_rs

WORKDIR /app/pac_engine_rs

# maturin writes the wheel here; the directory must exist before the build.
RUN mkdir -p ../target/wheels
RUN maturin build --release --out ../target/wheels

WORKDIR /app

# =========================================================================
# Stage 2: Final Python image
# =========================================================================
FROM python:3.11-slim

LABEL maintainer="hiro"

WORKDIR /app
ENV PYTHONPATH /app

# System dependencies: netcat/curl for healthchecks and DB-readiness waits,
# dos2unix to normalize shell-script line endings, libpq-dev for psycopg2,
# gfortran for building scientific wheels that lack manylinux binaries.
RUN apt-get update && apt-get install -y --no-install-recommends \
    netcat-traditional \
    curl \
    git \
    dos2unix \
    libpq-dev \
    gfortran \
    && rm -rf /var/lib/apt/lists/*

# Pinned dependency manifest, compiled from requirements.in via pip-compile.
COPY backend/requirements.txt /app/requirements.txt

# Application source. The volume mount (./backend:/app) mirrors this layout.
COPY backend /app/

# Copy the compiled wheel from the builder stage.
COPY --from=rust-builder /app/target/wheels /app/target/wheels

# Normalize line endings and mark the entrypoint executable. These files are
# part of the image; a missing one is a build error, not something to swallow.
RUN dos2unix /app/start_backend.sh /app/gunicorn_conf.py /app/utils/db_waiter.py /app/init_test_data.py \
    && chmod +x /app/start_backend.sh

# --default-timeout is raised because the scientific wheels (scipy, scikit-learn,
# shap, spacy) are large and can exceed pip's default socket timeout on slow links.
RUN pip install --no-cache-dir -r /app/requirements.txt --default-timeout=600

# Install the Rust wheel built in stage 1.
RUN pip install --no-cache-dir /app/target/wheels/*.whl

EXPOSE 8001

CMD ["/app/start_backend.sh"]
