# Dockerfile.ollama — pre-loads the qwen2.5 model into the Ollama image.
# qwen2.5:7b is lightweight (~4.7GB), CPU-friendly, and supports tool-calling.
FROM docker.io/ollama/ollama:latest AS builder
LABEL name="hiro-ollama-builder"
ENV OLLAMA_MODEL_TAG=qwen2.5:7b
ENV OLLAMA_EMBED_TAG=nomic-embed-text
# Run the server in the background, wait, then pull the chat + embedding models.
RUN (ollama serve &) \
    && echo "Waiting for Ollama server to start (5 seconds)..." \
    && sleep 5 \
    && ollama pull $OLLAMA_MODEL_TAG \
    && ollama pull $OLLAMA_EMBED_TAG \
    && echo "Model download complete."
# ====================================================================
# STAGE 2: Production (serves the pre-downloaded model)
# ====================================================================
FROM ollama/ollama:latest
LABEL name="hiro-ollama"
ENV OLLAMA_MODEL_TAG=qwen2.5:7b
# curl is needed for the Docker health check.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*
# Copy the pre-downloaded model binaries from the builder stage.
COPY --from=builder /root/.ollama/ /root/.ollama/
ENTRYPOINT ["/usr/bin/ollama", "serve"]
CMD []
