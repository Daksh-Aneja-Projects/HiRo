# Normalize line endings. Text files are LF in the repo.
* text=auto eol=lf

# Shell scripts and Dockerfiles MUST be LF (CRLF breaks them in Linux containers).
*.sh text eol=lf
Dockerfile* text eol=lf

# Windows scripts stay CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
