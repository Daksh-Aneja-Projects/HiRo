{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@hooks/*": ["src/hooks/*"],
      "@contexts/*": ["src/contexts/*"],
      "@utils/*": ["src/utils/*"],
      "@styles/*": ["src/styles/*"],
      "@assets/*": ["src/assets/*"],
      "@lib/*": ["src/lib/*"],
      "@pages/*": ["src/pages/*"],
      "@types/*": ["src/types/*"],
      "#components/*": ["src/components/*"],
      "#hooks/*": ["src/hooks/*"],
      "#utils/*": ["src/utils/*"],
      "#contexts/*": ["src/contexts/*"],
      "#styles/*": ["src/styles/*"],
      "#assets/*": ["src/assets/*"],
      "#lib/*": ["src/lib/*"]
    },
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022",
      "WebWorker"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "alwaysStrict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "removeComments": true,
    "importsNotUsedAsValues": "error",
    "checkJs": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo",
    "composite": true,
    "types": [
      "node",
      "jest",
      "@testing-library/jest-dom",
      "react",
      "react-dom"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  },
  "include": [
    "src/**/*",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".env.*",
    "setupTests.ts",
    "jest.config.js",
    "craco.config.js",
    "tailwind.config.js"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    ".cache",
    "coverage",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/__mocks__/*",
    "**/__tests__/*"
  ],
  "references": [
    { "path": "./tsconfig.node.json" }
  ],
  "compileOnSave": true,
  "typeAcquisition": {
    "enable": true,
    "include": [
      "react",
      "react-dom",
      "jest",
      "@types/node"
    ]
  }
}