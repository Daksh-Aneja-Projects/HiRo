# ====================================================================
# STAGE 1: Builder
# ====================================================================
FROM node:20-alpine AS builder
WORKDIR /app

# 1. Copy package files first to leverage Docker layer caching for node_modules
# Build context is project root, copying from the 'frontend' subdirectory.
COPY frontend/package.json .
COPY frontend/package-lock.json .

# 2. Install dependencies.
RUN npm install

# 3. Copy ALL remaining frontend source code (including src/ and craco.config.js)
# This step ensures the latest craco.config.js is used.
COPY frontend/ .

# 4. Run the build
RUN npm run build

# 5. Inject environment variables into the built assets
# CRITICAL FIX: Removed ALL citation tags that were corrupting the shell script.
RUN /bin/sh -c ' \
    echo "🎬 Starting environment variable injection inline..."; \
    VARS_TO_REPLACE="REACT_APP_BACKEND_URL REACT_APP_ENABLE_VISUAL_EDITS REACT_APP_ORCHESTRATOR_API_URL"; \
    for file in $(find ./build -type f -f -name "*.js" -o -name "*.css"); \
    do \
        echo "Processing $file..."; \
        for var_name in $VARS_TO_REPLACE; \
        do \
            var_value=$(eval echo "\$$var_name"); \
            escaped_value=$(echo "$var_value" | sed "s/\//\\\\\//g" | sed "s/&/\\\\&/g"); \
            sed -i "s/$var_name/$escaped_value/g" "$file" || true; \
        done; \
        echo "   ...Substitutions complete for $file."; \
    done; \
    echo "✅ Environment injection complete." \
'

# ====================================================================
# STAGE 2: Production (non-root: nginx-unprivileged runs as uid 101)
# ====================================================================
FROM nginxinc/nginx-unprivileged:alpine AS production

# Build-time file ops need root; the image drops back to the nginx user for runtime.
USER root

# 1. Copy Nginx Config (from frontend/nginx.conf)
COPY frontend/nginx.conf /etc/nginx/nginx.conf

# 2. Copy Wait Script (from ROOT)
COPY nginx-wait.sh /nginx-wait.sh
RUN chmod +x /nginx-wait.sh

# 3. Clean default files
RUN rm -rf /usr/share/nginx/html/*

# 4. Copy built assets (owned by the runtime nginx user)
COPY --from=builder --chown=nginx:nginx /app/build /usr/share/nginx/html

# Drop privileges for runtime.
USER nginx

CMD ["/nginx-wait.sh", "nginx", "-g", "daemon off;"]
EXPOSE 8080