# =========================================
# HiRo Platform — Git Ignore Rules
# =========================================

# Environment files (NEVER commit secrets)
.env
.env.local
.env.production
.env.staging
backend/.env
frontend/.env
frontend/.env.production.txt

# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/
dist/
build/
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
backend/app.log

# Archives & Backups
*.zip
*.tar.gz
*.backup
*.bak
frontend/src/App.js.backup

# Python virtual environments
venv/
.venv/
env/

# Docker
docker-compose.override.yml

# Testing
.coverage
htmlcov/
.pytest_cache/
coverage/

# Build artifacts
frontend/build/
*.whl

# Rust build artifacts
backend/pac_engine_rs/target/

# Secrets & Keys
*.pem
*.key
*.crt
*.p12
