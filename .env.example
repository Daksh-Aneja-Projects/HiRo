# .env.example
# =========================================================================================================
# HiRo ENTERPRISE PLATFORM — Environment Configuration Template
# ---------------------------------------------------------------------------------------------------------
# INSTRUCTIONS: Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# =========================================================================================================

# =====================================================
# Core Application Settings
# =====================================================
HOST=0.0.0.0
PORT=8001
ENV=development
LOG_LEVEL=INFO
APP_NAME="HiRo Enterprise API"
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
MAX_BODY_SIZE_MB=100
RATE_LIMIT_RPM=1000

# =====================================================
# Database Configuration
# =====================================================

# MongoDB
MONGO_ROOT_PASSWORD=CHANGE_ME_mongo_root_password
MONGO_USER=admin
MONGO_PASSWORD=CHANGE_ME_mongo_password
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB_NAME=hiro_db

# PostgreSQL
POSTGRES_USER=hiro_user
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
POSTGRES_DB=hiro_db

# Dgraph
DGRAPH_URL=http://dgraph-alpha:8080

# =====================================================
# NATS (JetStream for Agent Communication)
# =====================================================
NATS_URL=nats://nats:4222
NATS_JETSTREAM_DOMAIN=HIRO_STREAM
NATS_MAX_RETRIES=5
NATS_RETRY_SLEEP_SECONDS=2.0
NATS_CONNECT_TIMEOUT_SECONDS=5.0
TICKET_QUEUE_TOPIC=hcm.tickets.inbound

# =====================================================
# Authentication, Security & RBAC
# =====================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password
PII_SALT=CHANGE_ME_pii_salt_minimum_32_chars
DEFAULT_TEST_PASSWORD=CHANGE_ME_test_password
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_minimum_64_chars_random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AGENT_SIGNING_SECRET=CHANGE_ME_agent_signing_secret_minimum_32_chars
HRIT_MANAGER_APPROVERS=Alice_HRIT,Bob_Comp_VP

# =====================================================
# Federated AI Service Keys
# =====================================================
GEMINI_API_KEY=CHANGE_ME_your_gemini_api_key
GROQ_API_KEY=CHANGE_ME_your_groq_api_key
OLLAMA_BASE_URL=http://ollama:11434
GEMINI_MODEL_NAME=gemini-2.5-flash
GROQ_MODEL_NAME=llama-3.1-8b-instant
LLM_MODEL_NAME=llama3

# =====================================================
# AI Agent Configuration Defaults
# =====================================================
POLICY_SCRAPING_INTERVAL_SECONDS=21600
DTLA_SCENARIO_INTERVAL_SECONDS=43200
DTLA_RISK_THRESHOLD=0.8
EXTERNAL_API_TIMEOUT_SECONDS=30.0
SNOW_API_URL=https://mock.servicenow.com/api

# --- Timesheet Anomaly Detection AI ---
TIMESHEET_HISTORICAL_WEEKS=12
TIMESHEET_MAX_HOURS_OVERTIME_RISK=60.0
TIMESHEET_SCHEDULE_DEVIATION_THRESHOLD=0.2
TIMESHEET_HISTORICAL_DEVIATION_THRESHOLD=0.3
TIMESHEET_AUTO_APPROVE_SCORE=0.75
TIMESHEET_REVIEW_REQUIRED_SCORE=0.4
TIMESHEET_SCHEDULE_MATCH_WEIGHT=0.30
TIMESHEET_OVERTIME_WEIGHT=0.40
TIMESHEET_HISTORICAL_WEIGHT=0.30

# --- Hierarchical Enforcement ---
GLOBAL_MIN_AGE=16
GLOBAL_MAX_HOURS=60
UK_MAX_HOURS=48
UK_MIN_WAGE=11.44
US_CA_MIN_WAGE=16.00
POLICY_PRIORITY_LOW=50
POLICY_PRIORITY_MEDIUM=90
POLICY_PRIORITY_HIGH=100

# --- Enforcement Microservice ---
ENFORCEMENT_CACHE_TTL_SECONDS=300
ENFORCEMENT_TIME_TARGET_MS=5.0
TEMPORAL_STALE_DAYS=30
ENFORCER_AGENT_ID=RUNTIME_ENFORCER

# --- Ethical and Security Agents ---
PLR_HIGH_RISK_THRESHOLD=0.8
PLR_VULNERABILITIES=Documentation Gap,Jurisdictional Conflict,Termination Audit Failure
SDFA_BIAS_SCORE=0.01
SDFA_PQC_STATUS=ML-KEM Certified
SDFA_TIME_PER_RECORD_MS=0.05
ESA_FAIRNESS_SCORE=0.98
ESA_IMPACT_RATIO=1.02
EOA_ONTOLOGY_VERSION=EOA-V4.1
SPA_REMOTE_SILO_RISK=0.75
SPA_LOCAL_SILO_RISK=0.25
SPA_REMOTE_ACTION="Suggest cross-functional virtual coffee chats"
SPA_LOCAL_ACTION="Suggest team lunch"

# --- Workflow (BPMN) Defaults ---
BPMN_DEFAULT_START_NAME="Start Process"
BPMN_DEFAULT_POLICY_CHECK_NAME="Policy Check"
BPMN_DEFAULT_DECISION_NAME="Conditions Met?"
BPMN_DEFAULT_FINAL_APPROVAL_NAME="Final Approval"
BPMN_DEFAULT_END_NAME="Process Complete"
BPMN_SYSTEM_ASSIGNEE=SYSTEM
BPMN_MANAGER_ASSIGNEE=MANAGER
BPMN_POLICY_CHECK_CONDITION="IF Conditions"
BPMN_ADMIN_ASSIGNEE=ADMIN

# --- Data Ingestion ---
INGESTION_FORMATS=text/csv,application/json,text/plain
MAX_FILE_SIZE_MB=50

# --- PII Vault ---
PII_MOCK_CIPHERTEXT_PREFIX=MOCK_CIPHER_FOR_
PII_MOCK_PQC_KEY=CHANGE_ME_pqc_key
PII_POLICY_PAYROLL_PURPOSE=PAYROLL
PII_POLICY_ESS_PURPOSE=ESS_PROFILE_ACCESS
PII_POLICY_ADMIN_ROLE_SUFFIX=ADMIN
PII_POLICY_EMPLOYEE_ID_PREFIX=EMP

# --- Dynamic Compliance Engine ---
REGULATORY_FEED_URL=http://mock-regulatory-service:8080/feed
DEFAULT_GLOBAL_SCORE=88
MOCK_BASE_ALERTS=15

# =====================================================
# SI INTEGRATION: Streaming, Simulation & Telemetry
# =====================================================
STREAMING_CHUNK_SIZE=1024
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS=100
TELEMETRY_UPDATE_INTERVAL_SECONDS=5
STREAMING_TIMEOUT_SECONDS=300
ENABLE_LIVE_TELEMETRY=true
TELEMETRY_RETENTION_DAYS=30
METRICS_UPDATE_INTERVAL_SECONDS=5
MAX_CONCURRENT_STREAMS=10

# --- Simulation & Digital Twin ---
SIMULATION_MAX_WORKERS=10
SIMULATION_TIMEOUT_SECONDS=30
WHAT_IF_CACHE_TTL_SECONDS=300
SYNTHETIC_DATA_GENERATION_ENABLED=true
MAX_SYNTHETIC_RECORDS=10000
MAX_CONCURRENT_SIMULATIONS=5

# --- Remediation ---
REMEDIATION_MAX_ATTEMPTS=3
REMEDIATION_AUTO_APPLY=false
REMEDIATION_AI_MODEL=gemini-2.5-flash
REMEDIATION_TIMEOUT_SECONDS=60

# --- Agent Validation / Sandbox ---
SELF_CORRECTING_MAX_ITERATIONS=5
AGENT_SANDBOX_ENABLED=true
AGENT_VALIDATION_TIMEOUT_SECONDS=30

# --- Cache ---
REDIS_CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
SIMULATION_CACHE_TTL=600

# --- General Performance/Security ---
REQUEST_TIMEOUT_SECONDS=30
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60
ENABLE_JWT_AUTH=true

# --- Logging/Monitoring ---
ENABLE_STRUCTURED_LOGGING=true
LOG_JSON_FORMAT=true
SENTRY_DSN=

# --- Testing/Development Flags ---
ENABLE_MOCK_MODE=false
MOCK_AI_RESPONSES=false
DEBUG_MODE=false
ENABLE_MOCK_REGULATORY_FEEDS=false
ENABLE_POLICY_SCRAPING=true

# =====================================================
# Frontend Build Arguments
# =====================================================
FRONTEND_API_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REACT_APP_BACKEND_URL=http://localhost:8001
REACT_APP_ORCHESTRATOR_API_URL=http://localhost:8001
REACT_APP_GEMINI_API_KEY=CHANGE_ME_frontend_gemini_key
REACT_APP_JWT_SECRET=CHANGE_ME_frontend_jwt_secret
REACT_APP_ENABLE_VISUAL_EDITS=true
REACT_APP_OLLAMA_URL=http://localhost:11434
REACT_APP_WS_URL=ws://localhost:8001
REACT_APP_LOG_LEVEL=info
REACT_APP_VERSION=3.0.0
REACT_APP_SENTRY_DSN=
REACT_APP_ANALYTICS_ID=
NODE_ENV=development
